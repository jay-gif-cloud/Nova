<UserControl x:Class="Nova.LiveMonitoringPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="205">
    <Border Background="#B9162542" BorderBrush="#5A78AC" BorderThickness="1" CornerRadius="22" Padding="20">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.32" Color="#000000" /></Border.Effect>
        <StackPanel>
            <DockPanel><TextBlock Text="LIVE PERFORMANCE" FontSize="18" FontWeight="SemiBold" Foreground="#F0F6FF" /><TextBlock x:Name="SensorStatus" DockPanel.Dock="Right" Text="Detecting sensors…" Foreground="#7FE2FF" FontSize="11" VerticalAlignment="Center" /></DockPanel>
            <UniformGrid Columns="3" Margin="0,18,0,0">
                <StackPanel Margin="0,0,18,0"><TextBlock Text="CPU" Foreground="#91A9D4" FontSize="11" /><TextBlock x:Name="CpuLoadText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#63DDFF" /><TextBlock x:Name="CpuTempText" Text="Temperature —" Foreground="#C5D4ED" FontSize="12" /></StackPanel>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="GPU" Foreground="#91A9D4" FontSize="11" /><TextBlock x:Name="GpuLoadText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#B995FF" /><TextBlock x:Name="GpuTempText" Text="Temperature —" Foreground="#C5D4ED" FontSize="12" /></StackPanel>
                <StackPanel><TextBlock Text="MEMORY / FAN" Foreground="#91A9D4" FontSize="11" /><TextBlock x:Name="RamLoadText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#62F1B0" /><TextBlock x:Name="FanText" Text="Fan speed —" Foreground="#C5D4ED" FontSize="12" /></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
