<UserControl x:Class="Nova.LiveMonitoringPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="190">
    <Border Background="#101A31" BorderBrush="#31466F" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="Live Performance" FontSize="17" FontWeight="SemiBold" Foreground="#E6F0FF" />
                <TextBlock x:Name="SensorStatus" DockPanel.Dock="Right" Text="Detecting sensors…" Foreground="#8FA2D6" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            <UniformGrid Columns="3" Margin="0,14,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="CPU" Foreground="#8FA2D6" FontSize="11" />
                    <TextBlock x:Name="CpuLoadText" Text="—" FontSize="24" FontWeight="Bold" Foreground="#65D9FF" />
                    <TextBlock x:Name="CpuTempText" Text="Temperature —" Foreground="#B7C8EA" FontSize="12" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="GPU" Foreground="#8FA2D6" FontSize="11" />
                    <TextBlock x:Name="GpuLoadText" Text="—" FontSize="24" FontWeight="Bold" Foreground="#A98BFF" />
                    <TextBlock x:Name="GpuTempText" Text="Temperature —" Foreground="#B7C8EA" FontSize="12" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Memory" Foreground="#8FA2D6" FontSize="11" />
                    <TextBlock x:Name="RamLoadText" Text="—" FontSize="24" FontWeight="Bold" Foreground="#65FFB0" />
                    <TextBlock x:Name="FanText" Text="Fan speed —" Foreground="#B7C8EA" FontSize="12" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
