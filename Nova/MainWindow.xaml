<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nova"
        Title="Nova" Height="900" Width="1460" WindowStartupLocation="CenterScreen" Background="#070B18" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#111A2F" /><Setter Property="BorderBrush" Value="#2F3C60" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.28" Color="#000000" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource GlassPanel}"><Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#10244A" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#4CC8FF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" /></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#070B18" /><GradientStop Color="#141334" Offset=".45" /><GradientStop Color="#092642" Offset="1" /></LinearGradientBrush></Grid.Background>
        <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="18,12" Margin="0,0,0,18" Background="#0D1426" Opacity=".96" CornerRadius="16" BorderBrush="#31466F" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Nova" FontSize="26" FontWeight="Bold" Foreground="#EAF2FF" /><TextBlock Grid.Column="1" Text="Performance &amp; Storage Optimization Dashboard" FontSize="14" Foreground="#93A8DD" VerticalAlignment="Center" Margin="18,0,0,0" /><Border Grid.Column="2" Padding="12,8" CornerRadius="999" Background="#101E3C" BorderBrush="#3A5CA6" BorderThickness="1"><TextBlock x:Name="StatusText" Text="System Healthy" Foreground="#8BFFBA" FontWeight="SemiBold" /></Border></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.8*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="System Overview" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU load" Foreground="#8FA2D6" FontSize="12" /><TextBlock x:Name="CpuValue" Text="0%" FontSize="30" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Memory" Foreground="#8FA2D6" FontSize="12" /><TextBlock x:Name="MemoryValue" Text="0%" FontSize="30" FontWeight="Bold" /></StackPanel></Grid><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Disk" Foreground="#8FA2D6" FontSize="12" /><TextBlock x:Name="DiskValue" Text="0%" FontSize="30" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Network" Foreground="#8FA2D6" FontSize="12" /><TextBlock x:Name="NetworkValue" Text="0 MB/s" FontSize="24" FontWeight="Bold" /></StackPanel></Grid></StackPanel></Border>
                    <local:LiveMonitoringPanel Margin="0,0,0,12" />
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Storage Cleanup" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" /><WrapPanel Margin="0,14,0,0"><Button x:Name="CleanupTempButton" Style="{StaticResource ActionButton}" Width="160" Margin="0,0,12,12" Content="Clean Temp Files" Click="CleanupTempButton_Click" /><Button x:Name="CleanupRecycleButton" Style="{StaticResource ActionButton}" Width="170" Margin="0,0,0,12" Content="Empty Recycle Bin" Click="CleanupRecycleButton_Click" /><Button x:Name="CleanupLargeButton" Style="{StaticResource ActionButton}" Width="182" Margin="0,0,12,0" Content="Review Large Files" Click="CleanupLargeButton_Click" /><Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Width="140" Content="Refresh" Click="RefreshButton_Click" /></WrapPanel></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Startup Applications" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" /><ListBox x:Name="StartupList" Height="180" Margin="0,14,0,0" Background="#0B1220" BorderBrush="#2F3C60" Foreground="White"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="#9FB7EF" Margin="10,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="1"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Drive Health" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" /><ListView x:Name="DriveList" Height="220" Margin="0,12,0,0" Background="#0B1220"><ListView.View><GridView><GridViewColumn Header="Drive" DisplayMemberBinding="{Binding Name}" Width="120" /><GridViewColumn Header="Used" DisplayMemberBinding="{Binding UsedPercentLabel}" Width="120" /><GridViewColumn Header="Free" DisplayMemberBinding="{Binding FreeSpaceLabel}" Width="160" /><GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalSpaceLabel}" Width="160" /></GridView></ListView.View></ListView></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Top Cleanup Opportunities" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" /><ListView x:Name="CleanupList" Height="250" Margin="0,12,0,0" Background="#0B1220"><ListView.View><GridView><GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" Width="420" /><GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="120" /><GridViewColumn Header="Location" DisplayMemberBinding="{Binding DirectoryName}" Width="215" /></GridView></ListView.View></ListView></StackPanel></Border></StackPanel>
            </Grid></ScrollViewer>
        </Grid>
    </Grid>
</Window>
