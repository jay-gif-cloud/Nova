<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nova"
        Title="Nova" Height="900" Width="1460" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#070A14" Foreground="#F6F8FF" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelFill" Color="#B9141B32" />
        <SolidColorBrush x:Key="PanelStroke" Color="#445B86" />
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.34" Color="#000000" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#24365C" /><Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#5CD7FF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" /><Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F5F7FC" /><Setter Property="Foreground" Value="#101827" />
            <Setter Property="FontWeight" Value="Bold" /><Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#EDF3FF" /><Setter Property="Padding" Value="8,5" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#070A14" /><GradientStop Color="#121433" Offset="0.45" /><GradientStop Color="#092840" Offset="1" /></LinearGradientBrush></Grid.Background>
        <Canvas IsHitTestVisible="False" Opacity="0.5"><Ellipse Width="620" Height="620" Canvas.Left="-180" Canvas.Top="120" Fill="#6A3BFF" Opacity="0.16" /><Ellipse Width="760" Height="760" Canvas.Left="850" Canvas.Top="-120" Fill="#008DFF" Opacity="0.13" /><Ellipse Width="430" Height="430" Canvas.Left="650" Canvas.Top="570" Fill="#23D8C5" Opacity="0.08" /></Canvas>
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="22,16" Margin="0,0,0,20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="NOVA" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" /><TextBlock Text="SYSTEM CONTROL CENTER" FontSize="10" FontWeight="SemiBold" Foreground="#6AD9FF" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="Live performance, storage and startup insights" FontSize="14" Foreground="#A9B8D7" VerticalAlignment="Center" Margin="24,0,0,0" />
                    <Border Grid.Column="2" Padding="14,9" CornerRadius="999" Background="#163A36" BorderBrush="#57E6AC" BorderThickness="1"><TextBlock x:Name="StatusText" Text="System Healthy" Foreground="#72F2B5" FontWeight="SemiBold" /></Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="1.82*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <local:LiveMonitoringPanel Margin="0,0,0,16" />
                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Storage Cleanup" FontSize="18" FontWeight="SemiBold" Foreground="#E1EBFF" /><WrapPanel Margin="0,16,0,0"><Button x:Name="CleanupTempButton" Style="{StaticResource ActionButton}" Width="165" Content="Clean Temp Files" Click="CleanupTempButton_Click" /><Button x:Name="CleanupRecycleButton" Style="{StaticResource ActionButton}" Width="175" Content="Empty Recycle Bin" Click="CleanupRecycleButton_Click" /><Button x:Name="CleanupLargeButton" Style="{StaticResource ActionButton}" Width="185" Content="Review Large Files" Click="CleanupLargeButton_Click" /><Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Width="130" Content="Refresh" Click="RefreshButton_Click" /></WrapPanel></StackPanel></Border>
                    <Border Style="{StaticResource GlassPanel}"><StackPanel><TextBlock Text="Startup Applications" FontSize="18" FontWeight="SemiBold" Foreground="#E1EBFF" /><ListBox x:Name="StartupList" Height="205" Margin="0,16,0,0" Background="#6610182B" BorderBrush="#344A70" BorderThickness="1" Foreground="#EDF3FF"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#EDF3FF" /><TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="#78CFFF" Margin="14,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Drive Health" FontSize="18" FontWeight="SemiBold" Foreground="#E1EBFF" /><ListView x:Name="DriveList" Height="235" Margin="0,14,0,0" Background="#A6091222" BorderBrush="#344A70" BorderThickness="1" Foreground="#EDF3FF"><ListView.View><GridView><GridViewColumn Header="Drive" DisplayMemberBinding="{Binding Name}" Width="120" /><GridViewColumn Header="Used" DisplayMemberBinding="{Binding UsedPercentLabel}" Width="120" /><GridViewColumn Header="Free" DisplayMemberBinding="{Binding FreeSpaceLabel}" Width="160" /><GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalSpaceLabel}" Width="160" /></GridView></ListView.View></ListView></StackPanel></Border>
                    <Border Style="{StaticResource GlassPanel}"><StackPanel><TextBlock Text="Top Cleanup Opportunities" FontSize="18" FontWeight="SemiBold" Foreground="#E1EBFF" /><ListView x:Name="CleanupList" Height="285" Margin="0,14,0,0" Background="#A6091222" BorderBrush="#344A70" BorderThickness="1" Foreground="#EDF3FF"><ListView.View><GridView><GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" Width="420" /><GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="120" /><GridViewColumn Header="Location" DisplayMemberBinding="{Binding DirectoryName}" Width="250" /></GridView></ListView.View></ListView></StackPanel></Border>
                </StackPanel>
            </Grid></ScrollViewer>
        </Grid>
        <StackPanel Visibility="Collapsed"><TextBlock x:Name="CpuValue" /><TextBlock x:Name="MemoryValue" /><TextBlock x:Name="DiskValue" /><TextBlock x:Name="NetworkValue" /></StackPanel>
    </Grid>
</Window>
