<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nova"
        Title="Nova" Height="860" Width="1460" WindowStartupLocation="CenterScreen"
        Background="#050914" Foreground="White" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#111A2F" />
            <Setter Property="BorderBrush" Value="#2F3C60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.25" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0B1833" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4CC8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#010812" Offset="0" />
                <GradientStop Color="#071C34" Offset="0.22" />
                <GradientStop Color="#0A1238" Offset="0.55" />
                <GradientStop Color="#050914" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.9">
            <Ellipse Width="1100" Height="660" Canvas.Left="120" Canvas.Top="120" Fill="#18D7FF" Opacity="0.18" />
            <Ellipse Width="980" Height="610" Canvas.Left="520" Canvas.Top="150" Fill="#3E52FF" Opacity="0.15" />
            <Ellipse Width="930" Height="560" Canvas.Left="300" Canvas.Top="280" Fill="#FF56C8" Opacity="0.11" />
            <Ellipse Width="560" Height="360" Canvas.Left="770" Canvas.Top="250" Fill="#5EE3FF" Opacity="0.16" />
            <Ellipse Width="700" Height="420" Canvas.Left="130" Canvas.Top="460" Fill="#6DD7FF" Opacity="0.12" />
            <Ellipse Width="400" Height="260" Canvas.Left="980" Canvas.Top="540" Fill="#B45CFF" Opacity="0.10" />
            <Ellipse Width="200" Height="200" Canvas.Left="1020" Canvas.Top="120" Fill="#9EEAFF" Opacity="0.16" />
            <Ellipse Width="170" Height="170" Canvas.Left="200" Canvas.Top="540" Fill="#8CD8FF" Opacity="0.12" />

            <Ellipse Width="18" Height="18" Canvas.Left="150" Canvas.Top="120" Fill="White" Opacity="0.9" />
            <Ellipse Width="10" Height="10" Canvas.Left="260" Canvas.Top="90" Fill="#D8F5FF" Opacity="0.9" />
            <Ellipse Width="12" Height="12" Canvas.Left="420" Canvas.Top="160" Fill="White" Opacity="0.85" />
            <Ellipse Width="14" Height="14" Canvas.Left="520" Canvas.Top="110" Fill="#EBF9FF" Opacity="0.9" />
            <Ellipse Width="10" Height="10" Canvas.Left="660" Canvas.Top="120" Fill="#CFE8FF" Opacity="0.8" />
            <Ellipse Width="7" Height="7" Canvas.Left="800" Canvas.Top="90" Fill="White" Opacity="0.85" />
            <Ellipse Width="10" Height="10" Canvas.Left="910" Canvas.Top="180" Fill="#D8F8FF" Opacity="0.8" />
            <Ellipse Width="12" Height="12" Canvas.Left="1180" Canvas.Top="140" Fill="White" Opacity="0.9" />
            <Ellipse Width="10" Height="10" Canvas.Left="1260" Canvas.Top="250" Fill="#E5FBFF" Opacity="0.8" />
            <Ellipse Width="8" Height="8" Canvas.Left="1290" Canvas.Top="430" Fill="White" Opacity="0.8" />
            <Ellipse Width="12" Height="12" Canvas.Left="1120" Canvas.Top="560" Fill="#F3FBFF" Opacity="0.9" />
            <Ellipse Width="9" Height="9" Canvas.Left="980" Canvas.Top="640" Fill="#D8F4FF" Opacity="0.8" />
            <Ellipse Width="12" Height="12" Canvas.Left="760" Canvas.Top="720" Fill="White" Opacity="0.85" />
            <Ellipse Width="10" Height="10" Canvas.Left="620" Canvas.Top="690" Fill="#E7F5FF" Opacity="0.8" />
            <Ellipse Width="11" Height="11" Canvas.Left="420" Canvas.Top="660" Fill="White" Opacity="0.8" />
            <Ellipse Width="8" Height="8" Canvas.Left="250" Canvas.Top="610" Fill="#D9F8FF" Opacity="0.75" />
            <Ellipse Width="10" Height="10" Canvas.Left="80" Canvas.Top="520" Fill="White" Opacity="0.8" />
            <Ellipse Width="12" Height="12" Canvas.Left="170" Canvas.Top="760" Fill="#DCF5FF" Opacity="0.8" />
            <Ellipse Width="9" Height="9" Canvas.Left="450" Canvas.Top="780" Fill="White" Opacity="0.8" />
            <Ellipse Width="11" Height="11" Canvas.Left="900" Canvas.Top="760" Fill="#EAFBFF" Opacity="0.8" />
            <Ellipse Width="6" Height="6" Canvas.Left="1040" Canvas.Top="710" Fill="White" Opacity="0.8" />
            <Ellipse Width="10" Height="10" Canvas.Left="1320" Canvas.Top="720" Fill="#DFF9FF" Opacity="0.8" />

            <Ellipse Width="8" Height="8" Canvas.Left="190" Canvas.Top="420" Fill="White" Opacity="0.7" />
            <Ellipse Width="8" Height="8" Canvas.Left="330" Canvas.Top="370" Fill="#F1FDFF" Opacity="0.7" />
            <Ellipse Width="7" Height="7" Canvas.Left="610" Canvas.Top="430" Fill="White" Opacity="0.75" />
            <Ellipse Width="8" Height="8" Canvas.Left="1180" Canvas.Top="440" Fill="#E9F8FF" Opacity="0.7" />
            <Ellipse Width="6" Height="6" Canvas.Left="870" Canvas.Top="280" Fill="White" Opacity="0.7" />
            <Ellipse Width="3" Height="3" Canvas.Left="920" Canvas.Top="390" Fill="White" Opacity="0.8" />
            <Ellipse Width="4" Height="4" Canvas.Left="547" Canvas.Top="285" Fill="#D2F3FF" Opacity="0.9" />
            <Ellipse Width="5" Height="5" Canvas.Left="700" Canvas.Top="510" Fill="White" Opacity="0.8" />
            <Ellipse Width="3" Height="3" Canvas.Left="340" Canvas.Top="500" Fill="#E9F9FF" Opacity="0.8" />
            <Ellipse Width="4" Height="4" Canvas.Left="1120" Canvas.Top="330" Fill="White" Opacity="0.8" />
            <Ellipse Width="4" Height="4" Canvas.Left="1290" Canvas.Top="610" Fill="#E1F4FF" Opacity="0.75" />
            <Ellipse Width="5" Height="5" Canvas.Left="220" Canvas.Top="260" Fill="White" Opacity="0.8" />
            <Ellipse Width="4" Height="4" Canvas.Left="1320" Canvas.Top="150" Fill="#D4F7FF" Opacity="0.75" />
            <Ellipse Width="4" Height="4" Canvas.Left="510" Canvas.Top="740" Fill="White" Opacity="0.8" />
        </Canvas>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,12,18,12" Margin="0,0,0,18" Background="#0D1426" Opacity="0.9" CornerRadius="16" BorderBrush="#31466F" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nova" FontSize="26" FontWeight="Bold" Foreground="#EAF2FF" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Performance &amp; Storage Optimization Dashboard" FontSize="14" Foreground="#93A8DD" VerticalAlignment="Center" Margin="18,0,0,0" />
                    <Border Grid.Column="2" Padding="12,8" CornerRadius="999" Background="#101E3C" BorderBrush="#3A5CA6" BorderThickness="1">
                        <TextBlock x:Name="StatusText" Text="System Healthy" Foreground="#8BFFBA" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="System Overview" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU" Foreground="#8FA2D6" FontSize="12" />
                                    <TextBlock x:Name="CpuValue" Text="0%" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Memory" Foreground="#8FA2D6" FontSize="12" />
                                    <TextBlock x:Name="MemoryValue" Text="0%" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disk" Foreground="#8FA2D6" FontSize="12" />
                                    <TextBlock x:Name="DiskValue" Text="0%" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Network" Foreground="#8FA2D6" FontSize="12" />
                                    <TextBlock x:Name="NetworkValue" Text="0 MB/s" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Storage Cleanup" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="CleanupTempButton" Style="{StaticResource ActionButton}" Width="160" Margin="0,0,12,12" Content="Clean Temp Files" Click="CleanupTempButton_Click" />
                                <Button x:Name="CleanupRecycleButton" Style="{StaticResource ActionButton}" Width="170" Margin="0,0,0,12" Content="Empty Recycle Bin" Click="CleanupRecycleButton_Click" />
                                <Button x:Name="CleanupLargeButton" Style="{StaticResource ActionButton}" Width="182" Margin="0,0,12,0" Content="Review Large Files" Click="CleanupLargeButton_Click" />
                                <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Width="140" Content="Refresh" Click="RefreshButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Startup Applications" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            <ListBox x:Name="StartupList" Height="180" Margin="0,14,0,0" Background="#0B1220" BorderBrush="#2F3C60" BorderThickness="1" Foreground="White">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="White" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="#9FB7EF" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Drive Health" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            <ListView x:Name="DriveList" Height="220" Margin="0,12,0,0" Background="#0B1220" BorderBrush="#2F3C60" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Drive" DisplayMemberBinding="{Binding Name}" Width="120" />
                                        <GridViewColumn Header="Used" DisplayMemberBinding="{Binding UsedPercentLabel}" Width="120" />
                                        <GridViewColumn Header="Free" DisplayMemberBinding="{Binding FreeSpaceLabel}" Width="160" />
                                        <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalSpaceLabel}" Width="160" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Top Cleanup Opportunities" FontSize="17" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            <ListView x:Name="CleanupList" Height="250" Margin="0,12,0,0" Background="#0B1220" BorderBrush="#2F3C60" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" Width="420" />
                                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="120" />
                                        <GridViewColumn Header="Location" DisplayMemberBinding="{Binding DirectoryName}" Width="215" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
